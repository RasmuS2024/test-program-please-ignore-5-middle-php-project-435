{
    "name": "hexlet/store",
    "description": "Backend for the Hexlet computer components store",
    "type": "project",
    "require": {
        "php": "^8.3",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "robmorgan/phinx": "^0.16",
        "slim/psr7": "^1.8",
        "slim/slim": "^4.15"
    },
    "license": "MIT",
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs",
        "check": [
            "@lint",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
