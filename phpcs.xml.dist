<?xml version="1.0"?>
<ruleset name="Hexlet Store">
    <description>PHP_CodeSniffer configuration for the store backend.</description>

    <file>src</file>
    <file>public</file>
    <file>tests</file>
    <file>db</file>
    <file>phinx.php</file>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="p"/>

    <rule ref="PSR12"/>
</ruleset>
